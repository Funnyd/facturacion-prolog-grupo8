{
  "info": {"name":"Facturación Grupo 8","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:3000"}],
  "item":[
    {"name":"01 Productos","request":{"method":"GET","url":"{{baseUrl}}/api/productos"},"event":[{"listen":"test","script":{"exec":["pm.test('200 productos',()=>pm.response.to.have.status(200));","pm.test('catálogo no vacío',()=>pm.expect(pm.response.json().length).above(6));"]}}]},
    {"name":"02 Clientes","request":{"method":"GET","url":"{{baseUrl}}/api/clientes"},"event":[{"listen":"test","script":{"exec":["pm.test('200 clientes',()=>pm.response.to.have.status(200));","pm.test('cliente tiene nivel',()=>pm.expect(pm.response.json()[0]).to.have.property('nivel'));"]}}]},
    {"name":"03 Crear cliente","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"nombre\":\"Postman Cliente\",\"tipo\":\"contribuyente\",\"nivel\":\"plata\"}"},"url":"{{baseUrl}}/api/clientes"},"event":[{"listen":"test","script":{"exec":["pm.test('201 creado',()=>pm.response.to.have.status(201));","pm.test('cliente devuelve id',()=>pm.expect(pm.response.json().id).to.exist);"]}}]},
    {"name":"04 Crear producto","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"codigo\":\"postman-01\",\"nombre\":\"Producto Postman\",\"categoria\":\"general\",\"precio\":1000,\"stock\":3}"},"url":"{{baseUrl}}/api/productos"},"event":[{"listen":"test","script":{"exec":["pm.test('201 producto',()=>pm.response.to.have.status(201));","pm.test('precio guardado',()=>pm.expect(pm.response.json().precio).eq(1000));"]}}]},
    {"name":"05 Producto inválido","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"codigo\":\"error\",\"nombre\":\"Error\",\"categoria\":\"general\",\"precio\":0,\"stock\":0}"},"url":"{{baseUrl}}/api/productos"},"event":[{"listen":"test","script":{"exec":["pm.test('400 producto inválido',()=>pm.response.to.have.status(400));","pm.test('incluye explicación',()=>pm.expect(pm.response.json().error).to.match(/inválido/));"]}}]},
    {"name":"06 Crear factura válida","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"cliente_id\":1,\"forma_pago\":\"contado\",\"lineas\":[{\"producto_codigo\":\"p7\",\"cantidad\":2}]}"},"url":"{{baseUrl}}/api/facturas"},"event":[{"listen":"test","script":{"exec":["pm.test('201 factura',()=>pm.response.to.have.status(201));","pm.test('factura inicia borrador',()=>pm.expect(pm.response.json().estado).eq('borrador'));","pm.collectionVariables.set('facturaId',pm.response.json().id);"]}}]},
    {"name":"07 Emitir factura válida","request":{"method":"POST","url":"{{baseUrl}}/api/facturas/{{facturaId}}/emitir"},"event":[{"listen":"test","script":{"exec":["pm.test('200 emisión',()=>pm.response.to.have.status(200));","pm.test('estado emitida',()=>pm.expect(pm.response.json().estado).eq('emitida'));","pm.test('total positivo',()=>pm.expect(pm.response.json().total).above(0));"]}}]},
    {"name":"08 Crear factura inválida","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"cliente_id\":2,\"forma_pago\":\"credito\",\"lineas\":[{\"producto_codigo\":\"p2\",\"cantidad\":20}]}"},"url":"{{baseUrl}}/api/facturas"},"event":[{"listen":"test","script":{"exec":["pm.test('201 borrador inválido permitido',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('rechazadaId',pm.response.json().id);"]}}]},
    {"name":"09 Rechazar factura","request":{"method":"POST","url":"{{baseUrl}}/api/facturas/{{rechazadaId}}/emitir"},"event":[{"listen":"test","script":{"exec":["pm.test('200 respuesta de validación',()=>pm.response.to.have.status(200));","pm.test('estado rechazada',()=>pm.expect(pm.response.json().estado).eq('rechazada'));","pm.test('errores claros',()=>pm.expect(pm.response.json().errores.length).above(0));"]}}]},
    {"name":"10 Detalle inexistente","request":{"method":"GET","url":"{{baseUrl}}/api/facturas/999999"},"event":[{"listen":"test","script":{"exec":["pm.test('404 detalle',()=>pm.response.to.have.status(404));","pm.test('mensaje de error',()=>pm.expect(pm.response.json().error).to.exist);"]}}]},
    {"name":"11 Historial emitidas","request":{"method":"GET","url":"{{baseUrl}}/api/facturas?estado=emitida"},"event":[{"listen":"test","script":{"exec":["pm.test('200 historial',()=>pm.response.to.have.status(200));","pm.test('solo emitidas',()=>pm.expect(pm.response.json().every(x=>x.estado==='emitida')).to.be.true);"]}}]},
    {"name":"12 Reportes","request":{"method":"GET","url":"{{baseUrl}}/api/reportes"},"event":[{"listen":"test","script":{"exec":["pm.test('200 reportes',()=>pm.response.to.have.status(200));","pm.test('incluye ventas',()=>pm.expect(pm.response.json()).to.have.property('ventas'));","pm.test('incluye IVA',()=>pm.expect(pm.response.json()).to.have.property('iva'));","pm.test('incluye productos',()=>pm.expect(pm.response.json().productos).to.be.an('array'));"]}}]}
  ]
}
